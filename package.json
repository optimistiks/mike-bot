{
  "name": "mike-bot",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "db:generate": "pnpm --filter @mike-bot/bot-core db:generate",
    "db:migrate": "pnpm --filter @mike-bot/bot-core db:migrate",
    "dev": "turbo run dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "prepare": "husky",
    "set-webhook": "pnpm --filter @mike-bot/bot-core set-webhook",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "v1-export": "pnpm --filter @mike-bot/v1-export scan",
    "v1-import": "pnpm --filter @mike-bot/v1-import load"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "oxfmt": "^0.66.0",
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
