    "drizzle-orm": "^0.44.2",
    "embla-carousel-react": "9.0.0-rc03",
    "grammy": "^1.45.1",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.1",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.876.0",
