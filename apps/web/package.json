    "@types/react-dom": "19.2.4",
    "@vitest/browser-playwright": "4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.4",
    "drizzle-seed": "^0.3.1",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "4.1.11",
    "vitest-browser-react": "^2.2.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
