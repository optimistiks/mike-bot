{
  "name": "@mike-bot/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "browser:install": "playwright install chromium",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "fmt": "prettier --write ../.. --ignore-path ../../.prettierignore",
    "fmt:check": "prettier --check ../.. --ignore-path ../../.prettierignore",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-db.ts",
    "import:scan": "tsx scripts/import-scan.ts",
    "import:sql": "tsx scripts/import-sql.ts",
    "import:run": "tsx scripts/import-run.ts",
    "import:dump": "tsx scripts/import-dump.ts",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "set-webhook:recover": "tsx scripts/set-webhook.ts --recover"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@electric-sql/pglite": "^0.3.7",
    "@tanstack/react-query": "^5.101.4",
