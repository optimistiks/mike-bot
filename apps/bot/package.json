{
  "name": "@mike-bot/bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit --incremental false",
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "import:load": "tsx scripts/import-load.ts",
    "set-webhook": "tsx scripts/set-webhook.ts"
  },
  "dependencies": {
    "@vercel/functions": "^2.2.13",
    "ai": "^7.0.89",
    "drizzle-orm": "^0.44.7",
    "grammy": "^1.45.1",
    "hono": "^4.13.5",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "msw": "^2.15.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  }
}
