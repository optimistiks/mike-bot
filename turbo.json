{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "BOT_TOKEN",
        "BOT_WEBHOOK_SECRET",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "AI_GATEWAY_API_KEY"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "BOT_TOKEN",
        "BOT_WEBHOOK_SECRET",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "AI_GATEWAY_API_KEY"
      ]
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["topo", "^build"],
      "env": [
        "BOT_TOKEN",
        "BOT_WEBHOOK_SECRET",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "AI_GATEWAY_API_KEY"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^lint", "^build"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix", "^build"]
    },
    "fmt": {
      "cache": false
    },
    "fmt:check": {
      "cache": false
    }
  }
}
