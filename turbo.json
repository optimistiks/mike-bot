{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "BOT_TOKEN",
        "BOT_WEBHOOK_SECRET",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "typegen": {
      "outputs": [".next/types/**", "next-env.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["topo", "typegen"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "fmt": {
      "cache": false
    },
    "fmt:check": {
      "cache": false
    }
  }
}
