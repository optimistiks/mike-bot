{
  "name": "@mike-bot/bot-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": {
      "types": "./src/*",
      "default": "./dist/*"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json --incremental false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "ai": "^7.0.89",
    "drizzle-orm": "^0.44.7",
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^22.20.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "msw": "^2.15.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "4.1.11",
    "zod": "^4.4.3"
  }
}
